# fgx 配置示例：复制为 .env 后按需修改（Bun 会自动加载 .env，Vite 变量由父进程继承生效）

# ---- 后端 ----
# 后端监听端口
PORT=3100

# ---- 前端（仅 bun run dev 开发模式生效）----
# Vite dev 服务器端口
VITE_PORT=5173
# Vite 代理 /api 的目标地址（后端 PORT 改了要同步）
VITE_API_TARGET=http://localhost:3100

# ---- 文件存储（可选；不配置 S3_ENDPOINT 则用本地磁盘 data/files/ 兜底）----
# MinIO / S3 兼容存储
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=fgx
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
